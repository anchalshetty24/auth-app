PORT=3000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/authapp?retryWrites=true&w=majority
SESSION_SECRET=replace-with-a-long-random-string
BASE_URL=http://localhost:3000
NODE_ENV=development

# Optional SMTP for real reset emails (e.g. Gmail app password). If empty, the reset link is logged to the server console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Auth App <no-reply@example.com>

# Demo only: show the reset link on screen instead of emailing it. Set to false in real production.
DEMO_SHOW_RESET_LINK=true
